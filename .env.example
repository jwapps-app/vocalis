# Copy to .env and fill in. Compose refuses to start without POSTGRES_PASSWORD,
# deliberately: a default password on a service that binds a port is a trap.
#
#   openssl rand -hex 24
#
POSTGRES_PASSWORD=

# Host directory shared between the API container (mounted at /data) and the
# native TTS worker. Holds uploaded books, cached chapter audio, finished
# audiobooks and narrator clips — none of which belongs in git. Use an absolute
# path when running the worker as a service.
VOCALIS_DATA_DIR=./data

# --- only when the worker runs on a different machine from this stack ---
#
# The GPU machine has to reach Postgres over the network, so bind it beyond
# loopback and tell the Setup page's worker bundle where to find it. Both must
# be set, and the database password becomes the only thing guarding the port,
# so use a generated one.
#
# DB_BIND=0.0.0.0
# WORKER_DB_HOSTPORT=192.0.2.10:5445    # this machine's address on the LAN
