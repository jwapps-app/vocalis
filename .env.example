# Copy to .env and fill in. Compose refuses to start without POSTGRES_PASSWORD,
# deliberately: a default password on a service that binds a port is a trap.
#
#   openssl rand -base64 24
#
POSTGRES_PASSWORD=

# Host directory shared between the API container (mounted at /data) and the
# native TTS worker. Holds uploaded books, cached chapter audio, finished
# audiobooks and narrator clips — none of which belongs in git. Use an absolute
# path when running the worker as a service.
VOCALIS_DATA_DIR=./data

# Address the worker machine uses to reach Postgres, baked into the worker
# bundle the Setup page hands out. The default suits a worker on this same
# machine; for a worker elsewhere on the network, set this to the server's
# address and open the port. The password is never included in that bundle —
# install.sh asks for it on the machine that needs it.
# WORKER_DB_HOSTPORT=127.0.0.1:5445
