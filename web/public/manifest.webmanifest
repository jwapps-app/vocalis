{
  "name": "Vocalis",
  "short_name": "Vocalis",
  "description": "Turn EPUB books into chaptered M4B audiobooks, narrated locally on your own machine.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#4f46e5",
  "background_color": "#f6f7fb",
  "categories": ["books", "productivity", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Library",
      "short_name": "Library",
      "description": "Books converted and in progress",
      "url": "/?view=library",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Narrator setup",
      "short_name": "Setup",
      "description": "Install the narrator and check it is connected",
      "url": "/?view=setup",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
